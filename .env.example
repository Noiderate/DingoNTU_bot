# Copy these non-sensitive settings into .env.config
PUBLIC_BASE_URL=
DINGO_CHANNEL_ID=
PAYMENT_INSTRUCTION_IMAGE=
PAYMENT_INSTRUCTION_IMAGE_URL=

GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_SPREADSHEET_ID=

SUPABASE_URL=
SUPABASE_RECEIPTS_BUCKET=
# Keep a copy of each receipt image in the bucket (default false: the receipt
# stays on Telegram and only its hash is kept). Retention below only applies
# to copies that exist.
STORE_RECEIPT_IMAGES=
# Days to keep receipt images of finished orders (default 30, 0 = forever).
RECEIPT_RETENTION_DAYS=

# The Gemini models and their order are hardcoded in src/config.js (GEMINI_MODELS).
GEMINI_MAX_CONCURRENCY=
GEMINI_RPM=
VERIFY_SLOW_THRESHOLD_MS=
VERIFY_MAX_DURATION_MS=
VERIFY_MAX_ATTEMPTS=

PAYNOW_RECIPIENT_NAMES=
PAYNOW_RECIPIENT_ALIASES=
PAYNOW_UEN=
PAYNOW_PROXY_NUMBER=
PAYNOW_MERCHANT_NAME=
PAYMENT_MAX_AGE_MINUTES=
PAYMENT_CLOCK_SKEW_MINUTES=
PAYMENT_WINDOW_MINUTES=
PAYMENT_EXPIRY_ENABLED=
MAX_INCOMPLETE_ATTEMPTS=

# SGT hour the "Today's Orders" sheet tab treats as the start of a service
# day (default 15 = 3pm). A night delivery run crossing midnight stays on
# one service day instead of splitting at the calendar date change.
SERVICE_DAY_START_HOUR=

WORKER_TIME_BUDGET_MS=
# Time budget for one scheduled /api/cron/* run (default 15000). Keep it well
# under cron-job.org's 30 s timeout, which disables a job after 25 failures.
CRON_TIME_BUDGET_MS=
LOCK_LEASE_MS=
NODE_ENV=

# Copy these credentials into .env.secret
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
GOOGLE_SHEETS_PRIVATE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
CRON_SECRET=
