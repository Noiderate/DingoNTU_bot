# =============================================================================
# Dingo Post Form Bot - environment configuration
# =============================================================================
# Copy to `.env` for local development:   cp .env.example .env
# In production these are set in the Vercel dashboard (Project > Settings >
# Environment Variables), separately for Production and Preview.
#
# NOTHING IN HERE IS A REAL SECRET. Never commit a filled-in `.env`.
# =============================================================================


# --- Telegram ----------------------------------------------------------------

# From @BotFather. Use a SEPARATE bot token for local dev and Preview
# deployments. A single token cannot use long polling and a webhook at the same
# time - see MAINTENANCE.md "Local polling vs production webhook".
TELEGRAM_BOT_TOKEN=

# Random string you invent (e.g. `openssl rand -hex 32`). Telegram echoes it
# back in the X-Telegram-Bot-Api-Secret-Token header so the webhook can prove an
# update really came from Telegram. Must match what scripts/set-webhook.js sent.
TELEGRAM_WEBHOOK_SECRET=

# Public origin of the deployment, no trailing slash. Used by
# scripts/set-webhook.js to build the webhook URL.
# e.g. https://dingo-postform-bot.vercel.app
PUBLIC_BASE_URL=

# The public Dingo channel the delivery-mode announcements are posted to.
# Numeric ID (e.g. -1001234567890) or @channelusername. The bot must be an
# administrator of that channel with permission to post, edit and delete.
DINGO_CHANNEL_ID=

# The PayNow instruction image sent to customers after an admin confirms their
# order. Accepts any ONE of three forms - the bot auto-detects which:
#   - a Telegram file_id  (fastest, no upload; cached automatically after the
#     first successful send, so you can usually leave this blank)
#   - an https:// URL
#   - a path relative to the repo root, e.g. src/Payment_Instruction.png
PAYMENT_INSTRUCTION_IMAGE=
# Optional explicit URL fallback, used only if PAYMENT_INSTRUCTION_IMAGE is empty.
PAYMENT_INSTRUCTION_IMAGE_URL=


# --- Google Sheets -----------------------------------------------------------
# Sheets remains the source of truth for admin-managed config: the Settings,
# FoodAndStock and Hall tabs. The Orders tab is a mirror of Supabase.

# Service account email, e.g. dingo-bot@my-project.iam.gserviceaccount.com
# The spreadsheet must be shared with this address as an Editor.
GOOGLE_SHEETS_CLIENT_EMAIL=

# The service account's private key, INCLUDING the BEGIN/END lines.
# Must be wrapped in double quotes with literal \n escapes, on one line:
#   GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# When pasting into the Vercel dashboard, paste the real multi-line key instead.
GOOGLE_SHEETS_PRIVATE_KEY=

# The long ID from the sheet URL:
#   docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=


# --- Supabase ----------------------------------------------------------------
# Create the project in the Singapore region to match the sin1 Vercel region.

# e.g. https://abcdefghijk.supabase.co
SUPABASE_URL=

# Project Settings > API > service_role key. This bypasses Row Level Security,
# so it is strictly server-side. Never expose it to a browser or log it.
SUPABASE_SERVICE_ROLE_KEY=

# Private Storage bucket holding payment receipt images. Must NOT be public.
SUPABASE_RECEIPTS_BUCKET=payment-receipts


# --- Gemini ------------------------------------------------------------------
# Get a key from https://aistudio.google.com/apikey
#
# WARNING: Google's FREE tier uses submitted content to improve their products.
# Receipts contain names, bank details and phone numbers. Acceptable for a demo
# with internal test payments; move to a paid key before handling real customer
# payments. See MAINTENANCE.md "Security and data handling".
GEMINI_API_KEY=

# Current generally-available Flash model.
GEMINI_MODEL=gemini-3.8-flash

# Max receipts verified at once across ALL serverless instances. Counted from
# live locks in the database, not in memory. Keep at or below your tier's RPM.
GEMINI_MAX_CONCURRENCY=2

# Requests-per-minute ceiling for your Gemini tier. Free tier is ~15.
GEMINI_RPM=15

# After this long without a verdict, the customer's "Please wait" message is
# edited to "This is taking longer than expected, please wait". Sent once only.
VERIFY_SLOW_THRESHOLD_MS=8000

# Give up verifying after this long (10 min) and hand the receipt to an admin.
VERIFY_MAX_DURATION_MS=600000

# Give up after this many attempts and hand the receipt to an admin.
VERIFY_MAX_ATTEMPTS=8


# --- Payment verification rules ----------------------------------------------
# These decide whether a receipt is accepted. Edit them here (locally) or in the
# Vercel dashboard (production) - no code change or redeploy of source needed.
# Changing these takes effect on the next verification.

# Comma-separated display names that count as "paid to us", exactly as banks
# render them on a receipt. Case and punctuation are normalised before matching.
PAYNOW_RECIPIENT_NAMES=Dingo Cafe

# Extra spellings some banks show for the same payee (abbreviations, the
# registered entity name, trailing PTE LTD, etc). Comma-separated, optional.
PAYNOW_RECIPIENT_ALIASES=DINGO CAFE PTE LTD,DINGOCAFE

# Your PayNow UEN. Compared exactly after uppercasing. Optional but strongly
# recommended - it is the most reliable signal, since names vary by bank.
PAYNOW_UEN=

# Mobile or account proxy, if customers pay to a number rather than a UEN.
# Masked forms like ****123X are matched against this. Optional.
PAYNOW_PROXY_NUMBER=

# Reject receipts older than this many minutes at the moment they are received.
PAYMENT_MAX_AGE_MINUTES=30

# Tolerance for clock differences between the customer's bank app and us.
PAYMENT_CLOCK_SKEW_MINUTES=5

# How long a customer has to pay after an admin confirms their order. The
# deadline is judged on when they SENT the screenshot, not when verification
# finishes, so a slow check never costs someone their order.
PAYMENT_WINDOW_MINUTES=2

# Set false to record payment_due_at but never actually expire an order.
PAYMENT_EXPIRY_ENABLED=true

# How many "unfinished transfer" screenshots a customer may send for one order
# before it stops auto-replying and goes to an admin instead.
MAX_INCOMPLETE_ATTEMPTS=3


# --- Serverless / scheduling -------------------------------------------------

# Bearer token required by every /api/cron/* endpoint. Invent a random string,
# then give the same value to cron-job.org as an Authorization header.
CRON_SECRET=

# Stop work and hand the job back to the queue this long into an invocation, so
# it is released cleanly instead of being killed. Must stay comfortably under
# the maxDuration set in vercel.json (300s).
WORKER_TIME_BUDGET_MS=240000

# How long a distributed lock is held before it is considered abandoned. Covers
# the stock-deduction critical section that prevents overselling.
LOCK_LEASE_MS=30000


# --- Local development only --------------------------------------------------

# Set to `development` locally. When not `production`, `npm run dev` starts long
# polling instead of expecting a webhook.
NODE_ENV=development
